{
  "name": "apk-manager-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js + PostgreSQL API for APK distribution",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "knex": "knex --knexfile knexfile.cjs",
    "db:migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "db:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "db:status": "knex --knexfile knexfile.cjs migrate:status",
    "db:seed": "knex --knexfile knexfile.cjs seed:run",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "knex --knexfile knexfile.cjs migrate:rollback --all && npm run db:setup",
    "make:migration": "knex --knexfile knexfile.cjs migrate:make -x cjs",
    "make:seed": "knex --knexfile knexfile.cjs seed:make -x cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  }
}
