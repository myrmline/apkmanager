# Copy to .env and adjust
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apk_manager

# Auth — replace with a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Application files: public/{application}/icon.*, apks/, assets/
# "public" means files meant for distribution. The folder is never served
# statically; every file is reached through an authorised API route.
STORAGE_DIR=./public
# Where uploads land before they are validated and moved into place
UPLOAD_TMP_DIR=./tmp
MAX_UPLOAD_MB=300
MAX_ICON_MB=2
MAX_ASSET_MB=50

# Only read by the storage migration, to find files from the old flat layout
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Credentials created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
